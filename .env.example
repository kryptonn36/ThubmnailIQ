# Copy to .env and `export $(grep -v '^#' .env | xargs)` before running, or
# just export the ones you want to override — every value below already has
# a working local default (see internal/config/config.go) so the app runs
# with zero env vars set, using mock YouTube data and heuristic curiosity
# scoring instead of real external APIs.

# --- Optional real API keys (omit to use mocked/synthetic equivalents) ---

# Real competitor data from YouTube Data API v3 instead of synthetic mocks.
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Real Gemini-scored curiosity sub-score instead of a heuristic fallback.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which payment gateway to use for billing checkout: "razorpay" (default,
# works today without an invitation) or "stripe" (once your Stripe account
# is approved — flip this and set STRIPE_SECRET_KEY below, no code changes).
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=USD

# Razorpay test-mode keys — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe billing, used once PAYMENT_PROVIDER=stripe (currently invite-gated).
STRIPE_SECRET_KEY=

# --- Infra (defaults already match docker-compose.yml) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:PORT/DBNAME?sslmode=disable
REDIS_ADDR=localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_UPLOAD_BUCKET=thumbnailiq-uploads
S3_PUBLIC_BASE_URL=http://localhost:9000/thumbnailiq-uploads
CV_SERVICE_URL=http://localhost:8001

# --- JWT secrets (change for anything beyond local dev) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

SERVER_PORT=8080
SERVER_ENV=development
